# Database
DATABASE_URL=your_neon_postgres_url_here

# API Keys (server-side only, never exposed to client)
ANTHROPIC_API_KEY=your_anthropic_api_key
TICKETMASTER_API_KEY=your_ticketmaster_key
EVENTBRITE_API_KEY=your_eventbrite_key
SEATGEEK_API_KEY=your_seatgeek_client_id
GOOGLE_API_KEY=your_google_api_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id
SERPAPI_API_KEY=your_serpapi_key

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFICATION_EMAIL=where_to_send@gmail.com

# SMS Alerts via Twilio (optional). Required when an alert rule has
# channel_sms=true and no per-rule sms_to override. Numbers use E.164
# format (e.g. +17135551212).
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+15551234567
NOTIFICATION_SMS=+17135551212

# Scheduler
CRON_SCHEDULE=0 9 * * 5
# ^ Runs every Friday at 9 AM (adjust as needed)

# MCP custom-connector endpoint (optional). When set, /mcp speaks the
# Model Context Protocol so Perplexity / Claude Desktop / other MCP
# hosts can register this app as a custom connector. The full stack
# (OAuth authorization server, dynamic client registration, PKCE, /mcp
# handler, and .well-known metadata) is refused entirely when this is
# unset.
#
# MCP_BEARER_TOKEN is the operator's consent token: MCP clients drive
# their own OAuth flow to /oauth/authorize, which shows a consent page
# asking for this exact value. Once you approve, the server issues a
# short-lived access token to the client and it uses that on /mcp — no
# MCP client ever sees MCP_BEARER_TOKEN directly.
MCP_BEARER_TOKEN=change_me_to_a_long_random_string

# Public HTTPS origin of the deployment. Used as the OAuth issuer and
# to build metadata URLs. Set this to your Railway domain in
# production; the app cannot correctly advertise its OAuth metadata
# without it.
MCP_ISSUER_URL=https://your-app.up.railway.app

# Google Maps Platform API key. Required by the geo backfill (Places
# API v1) and by the future /map UI. When unset:
#   - list_events with radiusMiles works ONLY for already-geocoded rows
#   - find_venues_near still works against seeded coordinates
#   - enrich_venue_geo returns an "api key not set" error per row
# Restrict the key in the Google Cloud console to the APIs you use
# (Places API and Maps JavaScript API) and, ideally, to your Railway
# domain via HTTP-referrer / IP restrictions.
GOOGLE_MAPS_API_KEY=

# Server
PORT=5000
