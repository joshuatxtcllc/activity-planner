# Database
DATABASE_URL=your_neon_postgres_url_here

# API Keys (server-side only, never exposed to client)
ANTHROPIC_API_KEY=your_anthropic_api_key
TICKETMASTER_API_KEY=your_ticketmaster_key
EVENTBRITE_API_KEY=your_eventbrite_key
SEATGEEK_API_KEY=your_seatgeek_client_id
GOOGLE_API_KEY=your_google_api_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id
SERPAPI_API_KEY=your_serpapi_key

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFICATION_EMAIL=where_to_send@gmail.com

# SMS Alerts via Twilio (optional). Required when an alert rule has
# channel_sms=true and no per-rule sms_to override. Numbers use E.164
# format (e.g. +17135551212).
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+15551234567
NOTIFICATION_SMS=+17135551212

# Scheduler
CRON_SCHEDULE=0 9 * * 5
# ^ Runs every Friday at 9 AM (adjust as needed)

# Server
PORT=5000
