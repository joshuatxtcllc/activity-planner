# =====================================================
# REQUIRED ENVIRONMENT VARIABLES
# =====================================================

# Database Connection (PostgreSQL)
# Example: postgresql://user:password@host:port/database
DATABASE_URL=your-database-connection-string

# Session Secret (used for express-session)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-secure-session-secret

# =====================================================
# OPTIONAL API KEYS (for event aggregation features)
# =====================================================

# Ticketmaster Discovery API
# Get your key at: https://developer.ticketmaster.com/
VITE_TICKETMASTER_API_KEY=your-ticketmaster-api-key

# Eventbrite API (requires OAuth token)
# Get your key at: https://www.eventbrite.com/platform/
VITE_EVENTBRITE_API_KEY=your-eventbrite-oauth-token

# TripAdvisor Content API
# Get your key at: https://www.tripadvisor.com/developers
VITE_TRIPADVISOR_API_KEY=your-tripadvisor-api-key

# Google Custom Search API (for event search)
# Get your key at: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=your-google-api-key
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id

# =====================================================
# OPTIONAL INSTAGRAM INTEGRATION
# =====================================================

# Instagram Basic Display API
# Create an app at: https://developers.facebook.com/apps/
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# =====================================================
# NOTES
# =====================================================
# - Without API keys, the app will work with limited functionality
# - The app validates required variables on startup
# - Missing optional keys will show warnings but won't prevent startup
# - See README.md for detailed setup instructions
